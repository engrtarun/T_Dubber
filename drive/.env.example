# Supabase credentials for the drive app.
# Copy this file to .env.local and paste the real values in.
#
# Where they are:  Supabase dashboard → your project → ⚙ Project Settings → API
#
# NEXT_PUBLIC_ is safe to expose to the browser (it is the public project URL).
# SUPABASE_SERVICE_ROLE_KEY BYPASSES row-level security — server-only. Never
# rename it to NEXT_PUBLIC_*, or the key ships to every visitor.
#
# Deploys: set BOTH in the host's environment
#   Netlify    → Site configuration → Environment variables
#   Cloudflare → Pages → Settings → Environment variables
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-service-role-key-here