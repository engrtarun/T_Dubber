# Hugging Face connector config -- copy to .env and fill in.

# Token from https://huggingface.co/settings/tokens
# REQUIRED only for gated models (CohereX ASR). Public models
# (Homura-2B, Qwen3-TTS, OmniVoice, faster-whisper) download without it.
HF_TOKEN=

# Where hub caches live. Kaggle worker pins this to /kaggle/working/hf_cache
# so the cache survives with the notebook output.
HF_HOME=

# Kaggle + xet do not get along (uploads stall). Keep it 1.
HF_HUB_DISABLE_XET=1

# Optional: the T_Dubber edge Space (edge/server.go) that serves
# pylibs + weights 24/7. Set to the Space URL and hf_store will try
# it BEFORE hitting the hub -- a LAN fetch beats a 5 GB download.
TDUBBER_EDGE_URL=

# Optional: pin every model to an exact revision (a git SHA or a
# branch name). Empty = latest. Pin it in production so a repo
# update can never change your weights mid-run.
# HF_DEFAULT_REVISION=
